# Address of the Laravel backend (no trailing slash).
# Use "localhost" (not 127.0.0.1) so login cookies work between the two apps.
# NOTE: Every REACT_APP_ variable is built into the public JavaScript bundle.
# Never put passwords, API secrets or keys in this file.
REACT_APP_API_URL=http://localhost:8000

# false = bookings are sent to the Laravel API (POST /api/bookings) and admins
# see them in the dashboard. true = "mock mode" for trying the public pages
# without the backend: bookings stay in the visitor's own browser and a
# "Preview mode" notice is shown (see src/services/bookingService.js).
REACT_APP_USE_MOCK_BOOKINGS=false
