# Address of the Laravel backend (no trailing slash).
# Use "localhost" (not 127.0.0.1) so login cookies work between the two apps.
# NOTE: Every REACT_APP_ variable is built into the public JavaScript bundle.
# Never put passwords, API secrets or keys in this file.
REACT_APP_API_URL=http://localhost:8000

# The booking and contact APIs are not built yet, so the public booking pages
# run in "mock mode": bookings are saved in the visitor's own browser only and
# a "Preview mode" notice is shown. Set to false once POST /api/bookings and
# POST /api/bookings/lookup exist (see src/services/bookingService.js).
REACT_APP_USE_MOCK_BOOKINGS=true
